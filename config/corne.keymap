#define ZMK_POINTING_DEFAULT_MOVE_VAL 1300
#define ZMK_POINTING_DEFAULT_SCRL_VAL 18

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/keys.h>

&mt {
    flavor = "balanced";
    tapping-term-ms = <250>;
};

&caps_word {
    mods = <(MOD_LSFT)>;
    continue-list = <UNDERSCORE BACKSPACE DELETE MINUS>;
};

/ {
    combos {
        compatible = "zmk,combos";

        enter {
            bindings = <&kp ENTER>;
            key-positions = <37 29>;
        };

        num-period {
            bindings = <&kp PERIOD>;
            key-positions = <31 32>;
            layers = <2>;
        };

        num-comma {
            bindings = <&kp COMMA>;
            key-positions = <32 33>;
            layers = <2>;
        };

        GamingLayer {
            bindings = <&to 6>;
            key-positions = <2 3 4>;
            layers = <0>;
        };

        GameToColmak {
            bindings = <&to 0>;
            key-positions = <2 3 4>;
            layers = <6>;
        };

        ToLeague {
            bindings = <&to 8>;
            key-positions = <7 8 9>;
            layers = <0>;
        };

        LeagueToColmak {
            bindings = <&to 0>;
            key-positions = <7 8 9>;
            layers = <8>;
        };
    };

    macros {
        prmc: parentheses {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LEFT_PARENTHESIS &kp RIGHT_PARENTHESIS &kp LEFT>;
            label = "PARENTHESES";
        };

        bkmc: pbk {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LEFT_BRACKET &kp RIGHT_BRACKET &kp LEFT>;
            label = "PBK";
        };

        bcmc: bcmc {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LEFT_BRACE &kp RIGHT_BRACE &kp LEFT>;
            label = "BCMC";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        Colemak {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  | BKSP |
            // | CTRL |  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  ;  |  '   |
            // | SHFT |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  | ESC  |
            //                    | GUI | LWR | SPC |   | ENT | RSE  | ALT |

            display-name = "Colemak";
            bindings = <
&kp ESCAPE     &kp Q           &kp W           &kp F              &kp P            &kp B          &kp J        &kp L        &kp U              &kp Y            &kp SEMI         &kp EQUAL
&kp BACKSPACE  &mt LEFT_GUI A  &mt LEFT_ALT R  &mt LEFT_SHIFT S   &mt LCTRL T      &mt LC(T) G    &kp M        &mt RCTRL N  &mt RIGHT_SHIFT E  &mt RIGHT_ALT I  &mt RIGHT_GUI O  &kp SQT
&kp DELETE     &mt LC(Z) Z     &mt LC(X) X     &mt LC(C) C        &mt LC(V) D      &mt LC(N) V    &kp K        &kp H        &kp COMMA          &kp DOT          &kp FSLH         &kp MINUS
                                               &lt 5 PRINTSCREEN  &lt 1 BACKSPACE  &lt 2 TAB      &lt 3 ENTER  &lt 4 SPACE  &caps_word
            >;

            label = "Colemak";
        };

        Navigation {
            bindings = <
&trans  &none     &none         &none       &none      &none    &kp PAGE_UP    &kp HOME   &kp UP_ARROW  &kp END    &none      &none
&trans  &kp LGUI  &kp LEFT_ALT  &kp LSHIFT  &kp LCTRL  &none    &kp PAGE_DOWN  &kp LEFT   &kp DOWN      &kp RIGHT  &kp ENTER  &kp LC(Z)
&trans  &none     &none         &none       &none      &none    &kp INS        &kp LC(C)  &kp LC(V)     &kp LC(X)  &kp TAB    &kp LC(Y)
                                &none       &none      &none    &kp ENTER      &kp SPACE  &none
            >;

            label = "Nav";
        };

        Numpad {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  !  |  @  |  #  |  $  |  %  |   |  ^  |  &  |  *  |  (  |  )  | BKSP |
            // | CTRL |     |     |     |     |     |   |  -  |  =  |  [  |  ]  |  \  |  `   |
            // | SHFT |     |     |     |     |     |   |  _  |  +  |  {  |  }  | "|" |  ~   |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            display-name = "Numpad";
            bindings = <
&trans  &none         &none         &none           &none      &none    &kp MINUS  &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp PLUS   &none
&trans  &kp LEFT_GUI  &kp LEFT_ALT  &kp LEFT_SHIFT  &kp LCTRL  &none    &kp ASTRK  &kp N4        &kp N5        &kp N6        &kp ENTER  &kp COLON
&trans  &none         &none         &none           &none      &none    &kp SLASH  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp TAB    &none
                                    &none           &none      &none    &kp ENTER  &kp SPACE     &kp NUMBER_0
            >;

            label = "Numpad";
        };

        Symbols {
            bindings = <
&kp GRAVE  &kp EXCLAMATION  &kp AT_SIGN  &kp LEFT_BRACE        &kp RIGHT_BRACE        &kp AMPERSAND    &none  &none      &none       &none          &none     &none
&kp TILDE  &kp HASH         &kp DOLLAR   &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp ASTERISK     &none  &kp LCTRL  &kp RSHIFT  &kp RIGHT_ALT  &kp RGUI  &none
&kp EQUAL  &kp PERCENT      &kp CARET    &kp LEFT_BRACKET      &kp RIGHT_BRACKET      &kp EQUAL        &none  &none      &none       &none          &none     &none
                                         &none                 &kp NON_US_BACKSLASH   &kp PIPE         &none  &none      &none
            >;

            label = "Symbols";
        };

        Function {
            bindings = <
&trans  &kp F1    &kp F2   &kp F3   &kp F4   &kp F5     &none  &none      &none            &none          &none     &none
&trans  &kp F6    &kp F7   &kp F8   &kp F9   &kp F10    &none  &kp RCTRL  &kp RIGHT_SHIFT  &kp RIGHT_ALT  &kp RGUI  &none
&trans  &kp HOME  &kp END  &kp INS  &kp F11  &kp F12    &none  &none      &none            &none          &none     &none
                           &none    &none    &none      &none  &none      &none
            >;

            label = "Func";
        };

        Media {
            bindings = <
&none  &none     &none         &none       &none      &none    &none              &kp C_MUTE    &kp C_VOLUME_DOWN  &kp C_VOLUME_UP  &none         &none
&none  &kp LGUI  &kp LEFT_ALT  &kp LSHIFT  &kp LCTRL  &none    &ext_power EP_TOG  &kp C_PLAY    &kp C_PREV         &kp C_NEXT       &none         &none
&none  &none     &none         &none       &none      &none    &bt BT_CLR         &bt BT_SEL 0  &bt BT_SEL 1       &bt BT_SEL 2     &bt BT_SEL 3  &bt BT_SEL 4
                               &none       &none      &none    &none              &none         &none
            >;

            label = "Media";
        };

        Gaming_1 {
            bindings = <
&kp ESC    &kp TAB    &kp Q  &kp W  &kp E  &kp R        &none  &none  &none  &none  &none  &none
&kp LCTRL  &kp LSHFT  &kp A  &kp S  &kp D  &kp F        &none  &none  &none  &none  &none  &none
&kp B      &kp I      &kp Z  &kp X  &kp C  &kp V        &none  &none  &none  &none  &none  &none
                             &kp M  &mo 7  &kp SPACE    &none  &none  &none
            >;

            label = "Game 1";
        };

        Gaming_2 {
            bindings = <
&trans  &kp N6  &kp N7  &trans  &kp N8  &kp N9    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &kp N0    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &kp N1  &kp N2  &kp N3  &kp N4  &kp N5    &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans    &trans  &trans  &trans
            >;

            label = "Game 2";
        };

        League {
            bindings = <
&kp ESC  &kp N1  &kp N2  &kp N3    &kp N4     &kp N5       &trans  &trans  &trans  &trans  &trans  &trans
&kp TAB  &kp Q   &kp W   &kp E     &kp R      &kp T        &trans  &trans  &trans  &trans  &trans  &trans
&kp B    &kp A   &kp S   &kp D     &kp F      &kp G        &trans  &trans  &trans  &trans  &trans  &trans
                         &kp LALT  &kp LCTRL  &kp SPACE    &trans  &trans  &trans
            >;

            label = "League";
        };
    };
};
