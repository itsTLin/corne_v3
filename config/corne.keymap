#define ZMK_POINTING_DEFAULT_MOVE_VAL 1300
#define ZMK_POINTING_DEFAULT_SCRL_VAL 18

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

&mt {
    flavor = "balanced";
    tapping-term-ms = <250>;
};

&caps_word {
    mods = <(MOD_LSFT)>;
    continue-list = <UNDERSCORE BACKSPACE DELETE MINUS>;
};

/ {
    combos {
        compatible = "zmk,combos";

        enter {
            bindings = <&kp ENTER>;
            key-positions = <37 29>;
        };

        printscr {
            bindings = <&kp PRINTSCREEN>;
            key-positions = <26 27 28>;
            layers = <0>;
        };

        num-period {
            bindings = <&kp PERIOD>;
            key-positions = <31 32>;
            layers = <2>;
        };

        num-comma {
            bindings = <&kp COMMA>;
            key-positions = <32 33>;
            layers = <2>;
        };
    };

    macros {
        prmc: parentheses {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LEFT_PARENTHESIS &kp RIGHT_PARENTHESIS &kp LEFT>;
            label = "PARENTHESES";
        };

        bkmc: pbk {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LEFT_BRACKET &kp RIGHT_BRACKET &kp LEFT>;
            label = "PBK";
        };

        bcmc: bcmc {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LEFT_BRACE &kp RIGHT_BRACE &kp LEFT>;
            label = "BCMC";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        Colemak {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  | BKSP |
            // | CTRL |  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  ;  |  '   |
            // | SHFT |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  | ESC  |
            //                    | GUI | LWR | SPC |   | ENT | RSE  | ALT |

            display-name = "Colemak";
            bindings = <
&kp ESCAPE  &kp Q           &kp W           &kp F             &kp P            &kp B           &kp J        &kp L        &kp U              &kp Y            &kp SEMI         &kp EQUAL
&kp GRAVE   &mt LEFT_GUI A  &mt LEFT_ALT R  &mt LEFT_SHIFT S  &mt LCTRL T      &mt LC(T) G     &kp M        &mt RCTRL N  &mt RIGHT_SHIFT E  &mt RIGHT_ALT I  &mt RIGHT_GUI O  &kp SQT
&kp TILDE   &mt LC(Z) Z     &mt LC(X) X     &mt LC(C) C       &mt LC(V) D      &mt LC(N) V     &kp K        &kp H        &kp COMMA          &kp DOT          &kp FSLH         &kp NON_US_BACKSLASH
                                            &lt 0 TAB         &lt 1 BACKSPACE  &lt 2 DELETE    &lt 3 ENTER  &kp SPACE    &caps_word
            >;

            label = "Colemak";
        };

        Navigation {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  1  |  2  |  3  |  4  |  5  |   |  6  |  7  |  8  |  9  |  0  | BKSP |
            // | BTCLR| BT1 | BT2 | BT3 | BT4 | BT5 |   | LFT | DWN |  UP | RGT |     |      |
            // | SHFT |     |     |     |     |     |   |     |     |     |     |     |      |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            display-name = "Navigation";
            bindings = <
&trans  &none         &none         &none           &none      &none     &kp PAGE_UP    &kp HOME   &kp UP_ARROW  &kp END    &none      &none
&none   &kp LEFT_GUI  &kp LEFT_ALT  &kp LEFT_SHIFT  &kp LCTRL  &none     &kp PAGE_DOWN  &kp LEFT   &kp DOWN      &kp RIGHT  &kp ENTER  &kp LC(Z)
&none   &none         &none         &none           &none      &none     &kp INS        &kp LC(C)  &kp LC(V)     &kp LC(X)  &kp TAB    &kp LC(Y)
                                    &trans          &trans     &trans    &trans         &trans     &none
            >;

            label = "NavFunc";
        };

        Numpad {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  !  |  @  |  #  |  $  |  %  |   |  ^  |  &  |  *  |  (  |  )  | BKSP |
            // | CTRL |     |     |     |     |     |   |  -  |  =  |  [  |  ]  |  \  |  `   |
            // | SHFT |     |     |     |     |     |   |  _  |  +  |  {  |  }  | "|" |  ~   |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            display-name = "Numpad";
            bindings = <
&trans  &none         &none         &none           &none      &none     &kp MINUS  &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp PLUS   &none
&none   &kp LEFT_GUI  &kp LEFT_ALT  &kp LEFT_SHIFT  &kp LCTRL  &none     &kp ASTRK  &kp N4        &kp N5        &kp N6        &kp ENTER  &kp COLON
&none   &none         &none         &none           &none      &none     &kp SLASH  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp TAB    &none
                                    &trans          &trans     &trans    &kp ENTER  &kp SPACE     &kp NUMBER_0
            >;

            label = "Numpad";
        };

        Symbols {
            bindings = <
&kp GRAVE  &kp EXCLAMATION  &kp AT_SIGN  &kp LEFT_BRACE        &kp RIGHT_BRACE        &kp AMPERSAND           &none  &none      &none       &none          &none     &none
&kp TILDE  &kp HASH         &kp DOLLAR   &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp ASTERISK            &none  &kp LCTRL  &kp RSHIFT  &kp RIGHT_ALT  &kp RGUI  &none
&kp EQUAL  &kp PERCENT      &kp CARET    &kp LEFT_BRACKET      &kp RIGHT_BRACKET      &kp NON_US_BACKSLASH    &none  &none      &none       &none          &none     &none
                                         &kp UNDERSCORE        &kp MINUS              &kp PIPE                &none  &none      &none
            >;
        };

        Function {
            bindings = <
&trans  &kp F1  &kp F2  &kp F3  &kp F4   &kp F5     &trans  &trans  &trans  &trans  &trans  &trans
&trans  &kp F6  &kp F7  &kp F8  &kp F9   &kp F10    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &kp F11  &kp F12    &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans   &trans     &trans  &trans  &trans
            >;
        };
    };
};
